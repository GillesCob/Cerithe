datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile            Profile[]
  passwordResetToken PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Profile {
  id          String      @id @default(uuid())
  firstName   String?     @db.VarChar(50)
  lastName    String?     @db.VarChar(50)
  companyName String?     @db.VarChar(100)
  phoneNumber String?
  role        profileRole

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property Property[]

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transmissionAsSeller Transmission[] @relation("previousOwner")
  transmissionAsBuyer  Transmission[] @relation("newOwner")

  transmissionToken TransmissionToken[]
}

model Property {
  id             String    @id @default(uuid())
  name           String    @db.VarChar(50)
  address        String    @db.VarChar(50)
  houseType      houseType
  surface        Int
  numberOfLevels Int
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  room         Room[]
  project      Project[]
  task         Task[]
  document     Document[]
  transmission Transmission[]

  profileId         String
  profile           Profile             @relation(fields: [profileId], references: [id], onDelete: Cascade)
  transmissionToken TransmissionToken[]
}

model Room {
  id              String   @id @default(uuid())
  name            String   @db.VarChar(50)
  roomType        roomType
  surface         Int
  floorFinition   String   @db.VarChar(50)
  wallFinition    String   @db.VarChar(50)
  ceilingFinition String   @db.VarChar(50)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  task             Task[]
  document         Document[]
  project_has_room project_has_room[]

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Project {
  id          String        @id @default(uuid())
  title       String        @db.VarChar(50)
  description String        @db.VarChar(150)
  status      projectStatus
  startDate   DateTime
  endDate     DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  document         Document[]
  project_has_room project_has_room[]

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Task {
  id                    String     @id @default(uuid())
  title                 String     @db.VarChar(50)
  description           String     @db.VarChar(150)
  status                taskStatus
  budget                Int?
  professional          String?    @db.VarChar(150)
  professionalProfileId String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  propertyId String?
  roomId     String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room       Room?     @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Document {
  id        String       @id @default(uuid())
  title     String       @db.VarChar(150)
  type      documentType
  url       String       @db.VarChar(255)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  propertyId String?
  roomId     String?
  projectId  String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room       Room?     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Transmission {
  id        String   @id @default(uuid())
  amount    Decimal?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  previousOwnerId String
  newOwnerId      String
  previousOwner   Profile @relation("previousOwner", fields: [previousOwnerId], references: [id], onDelete: Cascade)
  newOwner        Profile @relation("newOwner", fields: [newOwnerId], references: [id], onDelete: Cascade)
}

model TransmissionToken {
  id                 String             @id @default(uuid())
  token              String             @unique
  recipientEmail     String
  status             transmissionStatus @default(pending)
  clickedAt          DateTime?
  expiresAt          DateTime?
  acceptedAt         DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime           @default(now())
  propertyId         String
  property           Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  recipientProfileId String?
  recipientProfile   Profile?           @relation(fields: [recipientProfileId], references: [id], onDelete: Cascade)

  // Vaut propertyId tant que la transmission est active (pending/clicked/accepted), null sinon.
  // Garantit au plus une transmission active par bien via une contrainte unique standard : Postgres
  // autorise plusieurs null dans une colonne @unique, donc les lignes inactives (confirmed/cancelled/expired)
  // ne se bloquent jamais entre elles. Remplace une tentative précédente par index partiel Postgres
  // (@@unique(... where: raw(...))), abandonnée car fonctionnalité preview Prisma buguée sur le diff.
  activePropertyId String? @unique
}

model project_has_room {
  projectId String
  roomId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  room      Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([projectId, roomId])
}

enum profileRole {
  PROFESSIONAL
  INDIVIDUAL
}

enum houseType {
  HOUSE
  APPARTMENT
}

enum roomType {
  BEDROOM
  KITCHEN
  LIVING_ROOM
}

enum projectStatus {
  TO_DO
  PENDING
  DONE
}

enum taskStatus {
  TO_DO
  PENDING
  DONE
}

enum documentType {
  QUOTE
  INVOICE
  BLUEPRINT
  PERMIT
  CONTRACT
  PHOTO
  MODEL
}

enum transmissionStatus {
  pending
  clicked
  accepted
  confirmed
  cancelled
  expired
}
